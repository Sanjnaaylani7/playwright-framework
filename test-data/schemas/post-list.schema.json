{
  "$id": "post-list",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "title", "body", "userId"],
    "properties": {
      "id": { "type": "integer" },
      "userId": { "type": "integer" },
      "title": { "type": "string", "minLength": 1 },
      "body": { "type": "string" }
    }
  }
}
