{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Playwright (JavaScript) UI + API automation framework: POM, data-driven JSON, Allure, Docker, Jenkins",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:headed": "HEADLESS=false playwright test --project=ui --headed",
    "test:list": "playwright test --list",
    "report:allure": "allure generate allure-results --output allure-report --clean",
    "report:open": "allure open allure-report",
    "report:html": "playwright show-report",
    "docker:build": "docker build -t playwright-framework .",
    "docker:test": "docker run --rm --ipc=host -v \"$PWD/allure-results:/app/allure-results\" -v \"$PWD/screenshots:/app/screenshots\" -v \"$PWD/logs:/app/logs\" playwright-framework"
  },
